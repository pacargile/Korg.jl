  CrH      0.0750   0.500  0.0450   0.500  0.00100  0.00060   6.220  CrH    # g0+dgdJ from GN+21 Tab.1
  FeH      0.0750   0.500  0.0450   0.500  0.00100  0.00060   6.550  FeH    # g0+dgdJ from GN+21 Tab.1
  H2       0.0713   0.650  0.0469   0.600  0.00007  0.00004  60.850  CO     # no analogue; H2 quadrupole lines are negligible here
  C2       0.0713   0.650  0.0469   0.600  0.00007  0.00004   1.820  CO     # first-row C-bearing diatomic
  CN       0.0713   0.650  0.0469   0.600  0.00007  0.00004   1.900  CO     # first-row C-bearing diatomic
  CO       0.0713   0.650  0.0469   0.600  0.00007  0.00004   1.930  CO
  MgO      0.1110   0.500  0.0602   0.500  0.00000  0.00000   0.574  MgO
